{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixatron Plus",
  "version": "0.1.0",
  "identifier": "com.pixatron.plus",
  "build": {
    "frontendDist": "../dist/pixatron-plus/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "yarn start",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "Pixatron Plus",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:pixatron.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
